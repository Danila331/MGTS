# Go API used by Next.js rewrites. No /api/v1 suffix.
API_URL=http://localhost:8080

# auto: сначала Go API, только при сетевой недоступности — typed localStorage fallback (по умолчанию)
# remote: строго Go API; network errors и HTTP 4xx/5xx показываются без mock-подмены
# mock: автономное демо без запросов к backend
NEXT_PUBLIC_API_MODE=auto
