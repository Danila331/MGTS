# Backend
STORAGE=memory
PORT=8080
DATABASE_URL=postgres://mgts:mgts@localhost:5432/mgts?sslmode=disable
LOG_LEVEL=info
PULSE_MODE=demo

# Optional model
PULSE_AI_ENDPOINT=
PULSE_AI_MODEL=
PULSE_AI_TOKEN=

# Optional integrations
PULSE_TALLY_SECRET=
PULSE_INVITE_KEY=
PULSE_TALLY_INTERN_FORM=
PULSE_TALLY_MENTOR_FORM=
PULSE_HUNTFLOW_TOKEN=
PULSE_HUNTFLOW_ACCOUNT=
PULSE_HUNTFLOW_WEB_URL=

# Production SSO and first startup
PULSE_AUTH_ISSUER=
PULSE_AUTH_AUDIENCE=
PULSE_AUTH_PUBLIC_KEY=
PULSE_PUBLIC_ORIGIN=
PULSE_BOOTSTRAP_FILE=

# Frontend / Next.js rewrites
API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_MODE=auto
